rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid', 'email', 'plan', 'createdAt'])
        && request.resource.data.plan == 'free'; // Initial plan must be free
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    // Logs Collection
    match /users/{userId}/resumes/{resumeId} {
      allow read, write: if isOwner(userId);
    }

    // Short URLs (Handled by server, but allowing public get just in case)
    match /shortUrls/{slug} {
      allow get: if true;
      allow write: if false; // Only admin can write via server
    }

    match /logs/{logId} {
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) 
                    || (request.resource.data.userId == 'anonymous');
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
